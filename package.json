{
  "name": "zattoo-remote",
  "version": "1.0.0",
  "description": "Zattoo Remote Controller - Electron App with Full DRM Support",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --remote-debugging-port=9229",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed"
  },
  "dependencies": {
    "electron": "^29.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "electron-builder": "^24.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.zattoo.remote",
    "productName": "Zattoo Remote",
    "files": [
      "**/*",
      "index.html",
      "src/zattoo_inject.js"
    ],
    "extraResources": [
      {
        "from": "src/",
        "to": "src/",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
